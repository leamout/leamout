# ─────────────────────────────────────────────────────────────
# Leamout local / deployment environment
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and replace the development defaults before
# deploying to production:
#
#   cp .env.example .env
#
# Never commit the generated .env file with production secrets.

# FreeSWITCH Event Socket password.
# Replace with a strong, unique value in production.
FREESWITCH_ESL_PASSWORD=change-me

# Public IP address advertised by RTPengine.
# Override with the host's public IP in production.
RTPENGINE_PUBLIC_IP=127.0.0.1

# TURN realm. This should normally match the public TURN hostname.
# Override with your public hostname in production.
TURN_REALM=turn.localhost

# TURN shared authentication secret.
# Generate a strong random value for production, for example:
#   openssl rand -hex 32
TURN_AUTH_SECRET=change-me

# Public IP address used by the TURN server.
# For a host behind NAT, use PUBLIC_IP/PRIVATE_IP.
# Override with the appropriate public address in production.
TURN_EXTERNAL_IP=127.0.0.1
