# ─────────────────────────────────────────────────────────────
# Leamout local / deployment environment
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and replace the development defaults before
# deploying to production:
#
#   cp .env.example .env
#
# Never commit the generated .env file with production secrets.

APP_ENV=development

# Browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# FreeSWITCH Event Socket address. Docker Compose overrides this with the
# internal `freeswitch:8021` service address for the API container.
FREESWITCH_ESL_ADDRESS=127.0.0.1:8021

# FreeSWITCH Event Socket password.
# Replace with a strong, unique value in production.
FREESWITCH_ESL_PASSWORD=change-me

# Base64url-encoded 32-byte AES key used to encrypt carrier credentials.
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
CARRIER_CREDENTIAL_ENCRYPTION_KEY=replace-with-generated-key

# Public IP address advertised by RTPengine.
# Override with the host's public IP in production.
RTPENGINE_PUBLIC_IP=127.0.0.1

# Internal Coturn listener used by the Leamout server readiness check.
# Docker Compose overrides this with coturn:3478.
TURN_ADDRESS=127.0.0.1:3478

# TURN realm. This should normally match the public TURN hostname.
# Override with your public hostname in production.
TURN_REALM=turn.localhost

# TURN shared authentication secret.
# Generate a strong random value for production, for example:
#   openssl rand -hex 32
TURN_AUTH_SECRET=replace-with-at-least-32-random-bytes

# Comma-separated ICE server URLs returned to authenticated clients. Use the
# public TURN hostname and include TLS/TCP for restrictive networks.
TURN_PUBLIC_URLS=stun:turn.localhost:3478,turn:turn.localhost:3478?transport=udp,turn:turn.localhost:3478?transport=tcp,turns:turn.localhost:5349?transport=tcp

# Public IP address used by the TURN server.
# For a host behind NAT, use PUBLIC_IP/PRIVATE_IP.
# Override with the appropriate public address in production.
TURN_EXTERNAL_IP=127.0.0.1
