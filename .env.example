# Infrastructure settings used by deploy/compose/docker.yaml.
# Keep this domain aligned with server/.env for Keycloak and Caddy routing.
DOMAIN=leamout.com
PUBLIC_IP=203.0.113.10
TURN_REALM=turn.leamout.com

# Must match the password in server/.env DATABASE_URL.
POSTGRES_PASSWORD=change-me-postgres

# Keycloak infrastructure (the client secret lives in server/.env).
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
