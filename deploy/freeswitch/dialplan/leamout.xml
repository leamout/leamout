<include>
  <context name="leamout">
    <extension name="echo-test">
      <condition field="destination_number" expression="^9196$">
        <action application="answer"/>
        <action application="echo"/>
      </condition>
    </extension>

    <!-- Temporary inbound PSTN smoke path. OpenSIPS has already authenticated
         the carrier source and resolved the DID to a trusted voice application.
         Answer and echo to prove two-way media through RTPengine end to end.
         Replace this with parked-channel control once the calls consumer owns
         inbound FreeSWITCH events. -->
    <extension name="inbound-voice-application-smoke">
      <condition field="${sip_h_X-Leamout-Voice-Application-ID}" expression="^.+$">
        <action application="log" data="NOTICE Leamout inbound PSTN smoke call application=${sip_h_X-Leamout-Voice-Application-ID} did=${destination_number}"/>
        <action application="answer"/>
        <action application="echo"/>
      </condition>
    </extension>
  </context>
</include>
