{
    email caddy@{$DOMAIN}
}

http://turn.{$DOMAIN} {
    handle /.well-known/acme-challenge/* {
        root * /srv/leamout-acme
        file_server
    }

    respond 404
}

api.{$DOMAIN} {
    # Prometheus scrapes the private server directly; do not proxy metrics.
    @privateMetrics path /metrics
    respond @privateMetrics 404

    reverse_proxy server:8080

    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000"
    }

    log {
        output stdout
        format json
    }
}

backoffice.{$DOMAIN} {
    reverse_proxy backoffice:8082

    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Strict-Transport-Security "max-age=31536000"
    }
}
