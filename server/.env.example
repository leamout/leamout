# Copy this file to server/.env for deployment.
# Compose loads it without overriding application defaults or validating these values.
APP_ENV=production
DOMAIN=leamout.com
DATABASE_URL=postgres://leamout:change-me-postgres@postgres:5432/leamout?sslmode=disable
REDIS_URL=redis://redis:6379/0
NATS_URL=nats://nats:4222
CORS_ORIGINS=https://leamout.com
TRUSTED_PROXY_CIDRS=

# Shared by the worker and FreeSWITCH.
FREESWITCH_ESL_ADDRESS=freeswitch:8021
FREESWITCH_ESL_PASSWORD=change-me-freeswitch

# Shared by the worker and media runtime.
MEDIA_CONTROL_URL=http://media:8090
MEDIA_CONTROL_TOKEN=change-me-media-control-token-at-least-32-bytes
MEDIA_TOKEN_SECRET=change-me-media-token-secret-at-least-32-bytes
# Other media settings use the Go runtime defaults unless overridden here.

# Raw URL-safe base64 encoded 16, 24, or 32 byte AES key.
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Shared by the API server and Coturn.
TURN_AUTH_SECRET=change-me-turn-secret
TURN_PUBLIC_URLS=stun:turn.leamout.com:3478,turn:turn.leamout.com:3478?transport=udp,turn:turn.leamout.com:3478?transport=tcp

# Provision this MinIO application user separately from the administrator.
MINIO_APP_ACCESS_KEY=leamout-app
MINIO_APP_SECRET_KEY=change-me-minio-app-password

# AWS defaults are defined by AWSConfig; set overrides here when needed.
# Use credentials with SES sending permissions for deployment outside AWS.
# AWS_REGION=us-east-1
# AWS_FROM_EMAIL=noreply@leamout.com
# AWS_CONFIGURATION_SET=leamout-transactional
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
