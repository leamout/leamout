# Copy this file to server/.env for deployment.
# Compose loads it without overriding application defaults or validating these values.
APP_ENV=production
DOMAIN=leamout.com
FRONTEND_URL=https://console.leamout.com
BACKEND_URL=https://api.leamout.com
DATABASE_URL=postgres://leamout:change-me-postgres@postgres:5432/leamout?sslmode=disable
REDIS_URL=redis://redis:6379/0
NATS_URL=nats://nats:4222
CORS_ORIGINS=https://console.leamout.com
TRUSTED_PROXY_CIDRS=

# Shared by the worker and FreeSWITCH.
FREESWITCH_ESL_ADDRESS=freeswitch:8021
FREESWITCH_ESL_PASSWORD=change-me-freeswitch

# Shared by the worker and media runtime.
MEDIA_CONTROL_URL=http://media:8090
MEDIA_CONTROL_TOKEN=change-me-media-control-token-at-least-32-bytes
MEDIA_TOKEN_SECRET=change-me-media-token-secret-at-least-32-bytes
# Other media settings use the Go runtime defaults unless overridden here.

# BYOA only: connect and verify organization-owned AI integrations through the API.
# Deployment-global AI provider keys are not used for Voice Agent execution.

# Raw URL-safe base64 encoded 16, 24, or 32 byte AES key.
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Shared by the API server and Coturn.
TURN_AUTH_SECRET=change-me-turn-secret
TURN_PUBLIC_URLS=stun:turn.leamout.com:3478,turn:turn.leamout.com:3478?transport=udp,turn:turn.leamout.com:3478?transport=tcp

# AWS SES credentials for deployment outside AWS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_FROM_EMAIL=noreply@leamout.com
# AWS_CONFIGURATION_SET=leamout-transactional


# Leamout Cloud is the primary managed product; no edition or license flags.
POLAR_ACCESS_TOKEN=
POLAR_ENVIRONMENT=production
POLAR_WEBHOOK_SECRET=
POLAR_DEVELOPER_PRODUCT_ID=58ff657a-74d9-4342-89c4-2a3b784c6965
POLAR_PRO_PRODUCT_ID=da5b3818-e92e-4b09-afad-ae61895f05db
POLAR_SCALE_PRODUCT_ID=a3023020-9822-4835-9509-1635c7d35f63

# Keycloak owns all user authentication. This client is confidential.
KEYCLOAK_ISSUER=https://auth.leamout.com/realms/leamout
KEYCLOAK_CLIENT_ID=leamout-console
KEYCLOAK_CLIENT_SECRET=replace-with-a-generated-secret
