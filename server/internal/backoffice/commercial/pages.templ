package commercial

import "github.com/leamout/leamout/internal/backoffice/components"

templ Page(accounts []Account) {
	@components.Layout("Commercial", "commercial", Content(accounts))
}

templ DetailPage(account Detail) {
	@components.Layout(account.Organization, "commercial", DetailContent(account))
}

templ DetailContent(account Detail) {
	@components.Breadcrumbs(components.BreadcrumbsProps{{Label: "Commercial", Attrs: templ.Attributes{"href": "/commercial/"}}, {Label: account.Organization}})
	<div class="mt-2 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
		<div>
			<p class="text-sm font-semibold uppercase tracking-wider text-base-content/60">Commercial account</p>
			<h1 class="mt-2 text-3xl font-bold">{ account.Organization }</h1>
			<p class="mt-2 font-mono text-xs text-base-content/60">{ account.OrganizationID }</p>
		</div>
		<span class="badge badge-outline badge-lg">{ account.BillingModel }</span>
	</div>
	<div class="stats stats-vertical lg:stats-horizontal mt-6 w-full border border-base-300 bg-base-100 shadow-sm">
		<div class="stat">
			<div class="stat-title">Billing model</div>
			<div class="stat-value text-3xl">{ account.BillingModel }</div>
			<div class="stat-desc">Pay before managed provider use</div>
		</div>
		<div class="stat">
			<div class="stat-title">Wallets</div>
			<div class="stat-value text-3xl">{ account.WalletCount }</div>
			<div class="stat-desc">Open prepaid wallets</div>
		</div>
		<div class="stat">
			<div class="stat-title">Currencies</div>
			<div class="stat-value text-xl">{ account.Currencies }</div>
			<div class="stat-desc">Available wallet currencies</div>
		</div>
	</div>
	<div class="mt-6 grid gap-6 xl:grid-cols-2">
		<section class="rounded-box border border-base-300 bg-base-100 p-6">
			<h2 class="text-lg font-semibold">PAYG account</h2>
			<dl class="mt-5 grid gap-5 sm:grid-cols-2">
				@DetailField("Billing model", account.BillingModel)
				@DetailField("Wallet count", account.WalletCount)
				@DetailField("Currencies", account.Currencies)
				@DetailField("Organization created", account.OrganizationCreatedAt)
			</dl>
		</section>
	</div>
}

templ Content(accounts []Account) {
	<div class="mb-6">
		<p class="text-sm font-semibold uppercase tracking-wider text-base-content/60">Commercial</p>
		<h1 class="mt-2 text-3xl font-bold">Commercial</h1>
		<p class="mt-2 text-base-content/70">Inspect organization prepaid wallet coverage and billing model.</p>
	</div>
	if len(accounts) == 0 {
		@EmptyState()
	} else {
		@AccountTable(accounts)
	}
}
