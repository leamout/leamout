package commercial

import "github.com/leamout/leamout/internal/backoffice/components"

templ AccountTable(accounts []Account) {
	@components.TableWithLinks(
		[]string{"Organization", "Billing Model", "Wallets", "Currencies"},
		accountRows(accounts),
		accountLinks(accounts),
	)
}

func accountLinks(accounts []Account) []components.TableCellLink {
	links := make([]components.TableCellLink, 0, len(accounts))
	for row, a := range accounts {
		links = append(links, components.TableCellLink{Row: row, Column: 0, Href: "/commercial/" + a.OrganizationID, Class: "link link-primary"})
	}
	return links
}

templ DetailField(label, value string) {
	<div><dt class="text-sm text-base-content/60">{ label }</dt><dd class="mt-1 break-all font-medium">{ value }</dd></div>
}

func accountRows(accounts []Account) [][]string {
	rows := make([][]string, 0, len(accounts))
	for _, account := range accounts {
		rows = append(rows, []string{
			account.Organization,
			account.BillingModel,
			account.WalletCount,
			account.Currencies,
		})
	}
	return rows
}

templ EmptyState() {
	<div class="alert"><span>No commercial accounts found.</span></div>
}
