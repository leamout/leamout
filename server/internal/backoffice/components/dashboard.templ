package components

templ Dashboard() {
	@Layout("Dashboard", "dashboard", DashboardContent())
}

templ DashboardContent() {
	<div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
		<div>
			<p class="text-sm font-semibold uppercase tracking-wider text-base-content/60">Operations</p>
			<h1 class="mt-2 text-3xl font-bold">Dashboard</h1>
			<p class="mt-2 max-w-2xl text-base-content/70">Operator controls for Leamout Cloud and telecom infrastructure.</p>
		</div>
		<button class="btn btn-primary" hx-get="/fragments/runtime-status" hx-target="#runtime-status" hx-swap="innerHTML">Check runtime</button>
	</div>
	<div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
		<div class="card border border-base-300 bg-base-100"><div class="card-body"><div class="text-sm text-base-content/60">Organizations</div><div class="text-2xl font-semibold">—</div></div></div>
		<div class="card border border-base-300 bg-base-100"><div class="card-body"><div class="text-sm text-base-content/60">Active calls</div><div class="text-2xl font-semibold">—</div></div></div>
		<div class="card border border-base-300 bg-base-100"><div class="card-body"><div class="text-sm text-base-content/60">Managed numbers</div><div class="text-2xl font-semibold">—</div></div></div>
		<div class="card border border-base-300 bg-base-100"><div class="card-body"><div class="text-sm text-base-content/60">Provider health</div><div class="text-2xl font-semibold">—</div></div></div>
	</div>
	<div id="runtime-status" class="alert mt-6"><span>Backoffice runtime ready. Use the check above to verify HTMX.</span></div>
}

templ RuntimeStatus() {
	<div class="alert alert-success">
		<span>Backoffice runtime is online on :8081.</span>
	</div>
}
