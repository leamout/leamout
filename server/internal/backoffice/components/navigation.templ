package components

templ Navigation(active string) {
	<div class="drawer-side">
		<label for="backoffice-drawer" aria-label="Close navigation" class="drawer-overlay"></label>
		<aside class="min-h-full w-72 border-r border-base-300 bg-base-100 p-4">
			<div class="px-4 py-4 text-lg font-bold">Leamout</div>
			<ul class="menu w-full gap-1">
				@NavigationItem("Dashboard", "/", "dashboard", active)
				@NavigationItem("Organizations", "/organizations", "organizations", active)
				@NavigationItem("Calls", "/calls", "calls", active)
				<li><span class="menu-title">Telecom</span></li>
				<li><span class="opacity-60">Numbers</span></li>
				<li><span class="opacity-60">Carriers</span></li>
				<li><span class="opacity-60">Trunks</span></li>
				<li><span class="opacity-60">Providers</span></li>
				<li><span class="menu-title">Operations</span></li>
				<li><span class="opacity-60">Commercial</span></li>
				<li><span class="opacity-60">Audit</span></li>
			</ul>
		</aside>
	</div>
}

templ NavigationItem(label string, href string, name string, active string) {
	<li><a href={ templ.SafeURL(href) } class={ templ.KV("menu-active", name == active) }>{ label }</a></li>
}
