package users

import "fmt"

templ UserTable(users []User) {
	<div class="overflow-x-auto rounded-box border border-base-300 bg-base-100">
		<table class="table">
			<thead>
				<tr>
					<th>User</th>
					<th>Status</th>
					<th>Email</th>
					<th>Organizations</th>
					<th>Access</th>
					<th>Created</th>
				</tr>
			</thead>
			<tbody>
				for _, user := range users {
					<tr>
						<td>
							<a class="link link-primary font-medium" href={ templ.SafeURL("/users/" + user.ID) }>{ user.Name }</a>
							<div class="text-xs text-base-content/60">{ user.Email }</div>
						</td>
						<td>{ user.Status }</td>
						<td>
							if user.EmailVerified {
								<span class="badge badge-success badge-sm">verified</span>
							} else {
								<span class="badge badge-ghost badge-sm">unverified</span>
							}
						</td>
						<td>{ fmt.Sprint(user.OrganizationCount) }</td>
						<td>
							if user.PlatformAdmin {
								<span class="badge badge-secondary badge-sm">platform admin</span>
							} else {
								<span class="text-base-content/60">user</span>
							}
						</td>
						<td>{ user.CreatedAt }</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ MembershipTable(memberships []OrganizationMembership) {
	if len(memberships) == 0 {
		<div class="alert"><span>No organization memberships found.</span></div>
	} else {
		<div class="overflow-x-auto rounded-box border border-base-300 bg-base-100">
			<table class="table">
				<thead>
					<tr>
						<th>Organization</th>
						<th>Role</th>
						<th>Membership</th>
						<th>Organization status</th>
						<th>Joined</th>
					</tr>
				</thead>
				<tbody>
					for _, membership := range memberships {
						<tr>
							<td>
								if membership.DetailAvailable {
									<a class="link link-primary font-medium" href={ templ.SafeURL("/organizations/" + membership.OrganizationID) }>{ membership.OrganizationName }</a>
								} else {
									<span class="font-medium">{ membership.OrganizationName }</span>
								}
								<div class="font-mono text-xs text-base-content/60">{ membership.OrganizationID }</div>
							</td>
							<td>{ membership.Role }</td>
							<td>{ membership.MembershipStatus }</td>
							<td>{ membership.OrganizationStatus }</td>
							<td>{ membership.JoinedAt }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ SessionTable(sessions []Session) {
	if len(sessions) == 0 {
		<div class="alert"><span>No sessions found.</span></div>
	} else {
		<div class="overflow-x-auto rounded-box border border-base-300 bg-base-100">
			<table class="table">
				<thead>
					<tr>
						<th>Session</th>
						<th>Assurance</th>
						<th>Status</th>
						<th>IP</th>
						<th>User agent</th>
						<th>Last seen</th>
						<th>Expires</th>
					</tr>
				</thead>
				<tbody>
					for _, session := range sessions {
						<tr>
							<td>
								<div class="font-mono text-xs">{ session.ID }</div>
								<div class="text-xs text-base-content/60">created { session.CreatedAt }</div>
							</td>
							<td>{ session.Assurance }</td>
							<td>{ session.Status }</td>
							<td>{ session.IPAddress }</td>
							<td class="max-w-md truncate" title={ session.UserAgent }>{ session.UserAgent }</td>
							<td>{ session.LastSeenAt }</td>
							<td>{ session.ExpiresAt }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ DetailField(label string, value string) {
	<div>
		<dt class="text-sm text-base-content/60">{ label }</dt>
		<dd class="mt-1 break-all font-medium">{ value }</dd>
	</div>
}
