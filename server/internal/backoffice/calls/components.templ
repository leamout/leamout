package calls

import "fmt"

templ CallTable(calls []Call) {
	<div class="overflow-x-auto rounded-box border border-base-300 bg-base-100">
		<table class="table">
			<thead><tr><th>Call</th><th>Organization</th><th>From</th><th>To</th><th>Direction</th><th>Duration</th><th>Status</th><th>Created</th></tr></thead>
			<tbody>
				for _, call := range calls {
					<tr>
						<td><a class="link link-primary font-mono text-xs" href={ templ.SafeURL("/calls/" + call.ID) }>{ call.ID }</a></td>
						<td><a class="link" href={ templ.SafeURL("/organizations/" + call.OrganizationID) }>{ call.Organization }</a></td>
						<td>{ call.From }</td><td>{ call.To }</td><td>{ call.Direction }</td><td>{ call.Duration }</td><td>{ call.Status }</td><td>{ call.CreatedAt }</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ DetailField(label string, value string) {
	<div><dt class="text-sm text-base-content/60">{ label }</dt><dd class="mt-1 break-all font-medium">{ value }</dd></div>
}

templ LinkedDetailField(label string, value string, href string) {
	<div><dt class="text-sm text-base-content/60">{ label }</dt><dd class="mt-1 break-all font-medium">
		if value == "—" {
			{ value }
		} else {
			<a class="link link-primary" href={ templ.SafeURL(href) }>{ value }</a>
		}
	</dd></div>
}

func recordingSummary(call Detail) string {
	return fmt.Sprintf("%d (%s)", call.RecordingCount, call.RecordingStatus)
}
