package calls

import "github.com/leamout/leamout/internal/backoffice/components"

templ CallTable(calls []Call) {
	@components.Table(
		[]string{"Call ID", "Organization", "From", "To", "Direction", "Duration", "Status", "Created"},
		callRows(calls),
	)
}

func callRows(calls []Call) [][]string {
	rows := make([][]string, 0, len(calls))
	for _, call := range calls {
		rows = append(rows, []string{
			call.ID,
			call.Organization,
			call.From,
			call.To,
			call.Direction,
			call.Duration,
			call.Status,
			call.CreatedAt,
		})
	}
	return rows
}
