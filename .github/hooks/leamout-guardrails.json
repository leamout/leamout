{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": "python3 scripts/agent/pre_tool_use.py",
        "powershell": "python scripts/agent/pre_tool_use.py",
        "timeoutSec": 5
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "python3 scripts/agent/agent_stop.py",
        "powershell": "python scripts/agent/agent_stop.py",
        "timeoutSec": 30
      }
    ]
  }
}
